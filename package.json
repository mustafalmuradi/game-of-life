{
  "name": "game-of-life",
  "version": "1.0.0",
  "description": "Mustafa's Game of Life tracker: a Claude artifact split into modules, with a golden-master regression harness",
  "directories": {
    "test": "test"
  },
  "scripts": {
    "test": "node test/stale-cache.mjs --new && node test/rest-full.mjs && node test/harness.mjs --shots",
    "test:record": "node test/harness.mjs --record --shots",
    "test:self": "node test/harness.mjs --old src --new src",
    "test:local": "node test/harness.mjs --old src --new src --noruntime",
    "test:legacy": "node test/harness.mjs --old legacy --new src",
    "test:stale": "node test/stale-cache.mjs --new",
    "check": "python3 tools/check-cascade.py && python3 tools/reassemble-js.py",
    "split": "python3 tools/split-css.py && python3 tools/split-js.py",
    "dist": "python3 tools/publish-prep.py",
    "test:rest": "node test/rest-full.mjs"
  },
  "devDependencies": {
    "pixelmatch": "^6.0.0",
    "playwright": "^1.56.1",
    "pngjs": "^7.0.0"
  },
  "private": true
}
